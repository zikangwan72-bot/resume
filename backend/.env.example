APP_NAME=Enterprise AI Suite API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./enterprise_ai.db
# Demo users/data are (re)seeded on startup in development/test by default.
# Set SEED_DEMO=false when this backend points at a shared database (e.g. Supabase).
# SEED_DEMO=false
LOG_LEVEL=INFO
JWT_SECRET=replace-this-in-production
TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=enterprise-files
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PUBLIC_APP_URL=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
